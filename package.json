{
  "name": "talk-electron-demo",
  "version": "0.0.0",
  "description": "Un client avanzato per ADI, con supporto per Electron e Angular.",
  "author": "Engineering Informatica S.p.a.",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "ng build && electron .",
    "electron:serve-with-inspect": "wait-on tcp:4200 && electron . --serve --inspect-brk=9229",
    "electron:build": "npm run build:prod && electron-builder build --publish=never",
    "build:css": "tailwindcss build src/styles.css -o dist/output.css",
    "watch:css": "tailwindcss build src/styles.css -o dist/output.css --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.0.6",
    "@tailwindcss/typography": "^0.5.16",
    "daisyui": "^4.12.23",
    "rxjs": "~7.8.0",
    "sqlite3": "^5.1.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.6",
    "@angular/cli": "^18.2.6",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.5.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.engineering.adi-client",
    "productName": "talk-electron-demo",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/",
      "package.json",
      "main.js",
      "db-worker.js",
      "preload.js"
    ],
    "extraFiles": [
      "public/"
    ],
    "asar": true,
    "win": {
      "icon": "public/engineering.ico"
    }
  }
}
